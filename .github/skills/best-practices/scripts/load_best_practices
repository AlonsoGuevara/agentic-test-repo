#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REFERENCES_DIR="$SCRIPT_DIR/../references"
FRAMEWORKS_DIR="$REFERENCES_DIR/frameworks"

list_languages() {
  echo "Available languages:"
  for f in "$REFERENCES_DIR"/*.md; do
    [ -f "$f" ] && echo "  - $(basename "$f" .md)"
  done
}

list_frameworks() {
  if [ -d "$FRAMEWORKS_DIR" ]; then
    echo "Available frameworks:"
    for f in "$FRAMEWORKS_DIR"/*.md; do
      [ -f "$f" ] && echo "  - $(basename "$f" .md)"
    done
  fi
}

if [ $# -eq 0 ]; then
  echo "Usage: load_best_practices <language> [framework]"
  echo ""
  list_languages
  echo ""
  list_frameworks
  exit 1
fi

LANGUAGE="${1,,}"
LANG_FILE="$REFERENCES_DIR/$LANGUAGE.md"

if [ ! -f "$LANG_FILE" ]; then
  echo "Error: No best practices found for language '$LANGUAGE'."
  echo ""
  list_languages
  exit 1
fi

cat "$LANG_FILE"

shift
for FRAMEWORK in "$@"; do
  FRAMEWORK="${FRAMEWORK,,}"
  FRAMEWORK_FILE="$FRAMEWORKS_DIR/$FRAMEWORK.md"

  if [ ! -f "$FRAMEWORK_FILE" ]; then
    echo ""
    echo "Error: No best practices found for framework '$FRAMEWORK'."
    echo ""
    list_frameworks
    exit 1
  fi

  echo ""
  echo "---"
  echo ""
  cat "$FRAMEWORK_FILE"
done
